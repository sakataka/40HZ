{
  "name": "forty-hz-stimulation-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun --hot scripts/dev-frontend.ts",
    "build": "bun run typecheck && bun run scripts/build-frontend.ts --base ./",
    "build:pages": "bun run typecheck && bun run scripts/build-frontend.ts --base /40HZ/",
    "preview": "bun run scripts/dev-frontend.ts --preview",
    "test": "bun test tests",
    "typecheck": "bun check --build --threads=4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2"
  }
}
